rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Server-only OTP & Index collections — Admin SDK only (deny all browser requests)
    match /phone_index/{phone} {
      allow read, write: if false;
    }

    match /email_otp/{email} {
      allow read, write: if false;
    }

    match /email_otp_rate/{rateKey} {
      allow read, write: if false;
    }

    // User document and user subcollections
    match /users/{userId} {
      allow read: if isOwner(userId);

      // Prevent client from setting/modifying restricted fields: phone_verified, whatsapp_opt_in, isGuest
      allow create: if isOwner(userId)
        && (!request.resource.data.keys().hasAny(['phone_verified', 'whatsapp_opt_in', 'isGuest'])
            || (request.resource.data.phone_verified == false && request.resource.data.whatsapp_opt_in == false));

      allow update: if isOwner(userId)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone_verified', 'whatsapp_opt_in', 'isGuest']));

      allow delete: if isOwner(userId);

      // Subcollections (tasks, projects, labels)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
